					const textareaRef = ref(null);
					const imageList = ref([]);
					const allSelected = ref(true);

					// 记录
					const records = ref([]);
					const isRecordsLoading = ref(false);

					// Modal 与 Lightbox & Toast
					const statModal = ref({ visible: false, title: '', value: '' });
					const lightbox = ref({ visible: false, url: '' });
					const toast = ref({ visible: false, message: '' });

					// 示例数据 (1:1 来自 DouMP)
					const exampleLinks = [
						{ label: '视频示例', text: '9.41 复制打开抖音，看看【逐花归海.的作品】"我对流星许愿,希望你永远快乐·" ᴵ ʷⁱˢʰ ... https://v.douyin.com/fE0ws7peYUU/ C@u.sR xsE:/ 10/04 ' },
						{ label: '图片示例', text: '9.76 复制打开抖音，看看【ঞᐝ完美の的图文作品】好看的图片当然要分享给好看的你呀·ᰔ ᩚ。# 治愈... https://v.douyin.com/33ROpXvhz3Y/ 10/12 LWZ:/ j@C.hb' }
					];

					// 获取或初始化 OpenID
					const getOpenId = () => {
						let id = localStorage.getItem('dou_openid');
						if (!id) {
							id = 'web_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8);
							localStorage.setItem('dou_openid', id);
						}
						return id;
					};

					const showToast = (msg, duration = 2000) => {
						toast.value.message = msg;
						toast.value.visible = true;
						setTimeout(() => {
							toast.value.visible = false;
						}, duration);
					};

					// 页面导航
					const goToPage = (page) => {
						currentPage.value = page;
						window.location.hash = page;
						if (page === 'records') {
							fetchRecords();
						}
					};

					// 视频代理 Src
					const videoProxySrc = computed(() => {
						if (parseResult.value?.project?.type === 'video') {
							return parseResult.value.project?.url_list?.[0] || '';
						}
						return '';
					});

					// 已选图片数量
					const selectedCount = computed(() => {
						return imageList.value.filter(item => item.selected).length;
					});

					// 输入粘贴与清空
					const pasteInput = async () => {
						try {
							if (navigator.clipboard && navigator.clipboard.readText) {
								const text = await navigator.clipboard.readText();
								if (text) {
									shareText.value = text;
									showToast('已从剪贴板粘贴');
									parseVideo();
									return;
								}
							}
							showToast('无法读取剪贴板，请手动粘贴');
						} catch (e) {
							showToast('请手动粘贴内容');
						}
					};

					const clearInput = () => {
						if (!shareText.value.trim()) {
							showToast('输入框已经是空的');
							return;
						}
						shareText.value = '';
					};

					const useExample = (index) => {
						shareText.value = exampleLinks[index].text;
						parseVideo();
					};

					// 执行解析
					const parseVideo = async () => {
						const text = shareText.value.trim();
						if (!text) {
							showToast('请输入链接信息');
							return;
						}

						isLoading.value = true;
						const openid = getOpenId();

						try {
							const res = await fetch('/api/parse', {
								method: 'POST',
								headers: { 'Content-Type': 'application/json' },
								body: JSON.stringify({ shareText: text, openid })
							});
							const data = await res.json();

							if (res.ok && data.success) {
								parseResult.value = data.data;
								// 图集初始化
								if (data.data?.project?.url_list) {
									imageList.value = data.data.project.url_list.map((url, idx) => ({
										id: idx + 1,
										url,
										selected: true
									}));
									allSelected.value = true;
								}
								goToPage('detail');
							} else {
								alert(data.error || '解析失败，请检查链接');
							}
						} catch (err) {
							showToast('网络请求失败，请检查网络');
						} finally {
							isLoading.value = false;
						}
					};

					// 图集操作
					const toggleSelectAll = () => {
						allSelected.value = !allSelected.value;
						imageList.value.forEach(item => item.selected = allSelected.value);
					};

					const toggleImageSelect = (id) => {
						const item = imageList.value.find(img => img.id === id);
						if (item) {
							item.selected = !item.selected;
						}
						allSelected.value = imageList.value.every(img => img.selected);
					};

					const previewImage = (url) => {
						if (!url) return;
						lightbox.value.url = url;
						lightbox.value.visible = true;
					};

					// 文本复制
					const copyText = async (text, label) => {
						if (!text) return;
						try {
							await navigator.clipboard.writeText(String(text));
							showToast(`${label}已复制`);
						} catch (e) {
							showToast('复制失败');
						}
					};

					const copyAuthorInfo = async () => {
						if (!parseResult.value) return;
						const text = `${parseResult.value.project?.title || ''}\n\n作者：${parseResult.value.author?.nickname} (${parseResult.value.author?.author_id})`;
						try {
							await navigator.clipboard.writeText(text);
							showToast('已复制作品信息');
						} catch (e) {
							showToast('复制失败');
						}
					};

					const showStatModal = (title, value) => {
						statModal.value = {
							visible: true,
							title: title + '数据',
							value: value ?? 0
						};
					};

					// 下载功能
					const downloadVideo = () => {
						if (!videoProxySrc.value) {
							showToast('视频地址无效');
							return;
						}
						const sizeList = parseResult.value?.project?.size_list || [];
						if (sizeList.length > 0 && sizeList[0] > 50 * 1024 * 1024) {
							alert('当前视频超过 50MB，暂不支持直接下载保存。');
							return;
						}
						const title = parseResult.value?.project?.title || 'video';
						const downloadUrl = `/api/download-stream?url=${encodeURIComponent(videoProxySrc.value)}&title=${encodeURIComponent(title)}`;
						window.open(downloadUrl, '_blank');
					};

					const downloadImages = () => {
						const selected = imageList.value.filter(i => i.selected);
						if (selected.length === 0) {
							showToast('请先选择图片');
							return;
						}
						selected.forEach(img => {
							const a = document.createElement('a');
							a.href = img.url;
							a.download = `image_${img.id}.jpg`;
							document.body.appendChild(a);
							a.click();
							document.body.removeChild(a);
						});
						showToast(`已触发 ${selected.length} 张图片下载`);
					};

					// 微信/网页分享 (兼容 Web Share API 与剪贴板复制)
					const shareApp = async () => {
						const title = parseResult.value?.project?.title
							? `${parseResult.value.author?.nickname || ''}的作品：${parseResult.value.project.title}`
							: '天天下载 - 无水印解析下载器';
						const shareUrl = window.location.href;

						if (navigator.share) {
							try {
								await navigator.share({
									title: title,
									text: '快速解析视频，支持无水印下载',
									url: shareUrl
								});
								return;
							} catch (e) {
								if (e.name === 'AbortError') return;
							}
						}

						try {
							await navigator.clipboard.writeText(shareUrl);
							showToast('页面链接已复制，快去分享给好友吧！');
						} catch (e) {
							showToast('链接复制失败');
						}
					};

					// 获取解析历史
					const fetchRecords = async () => {
						isRecordsLoading.value = true;
						const openid = getOpenId();
						try {
							const res = await fetch(`/api/records?openid=${encodeURIComponent(openid)}`);
							const data = await res.json();
							if (res.ok && data.success) {
								records.value = data.data || [];
							} else {
								records.value = [];
							}
						} catch (e) {
							showToast('获取历史记录失败');
						} finally {
							isRecordsLoading.value = false;
						}
					};

					const reParse = (url) => {
						if (!url) return;
						shareText.value = url;
						parseVideo();
					};

					// 格式化辅助函数
					const formatCount = (count) => {
						if (!count && count !== 0) return '0';
						const num = Number(count);
						if (isNaN(num)) return count;
						if (num >= 10000) {
							return (num / 10000).toFixed(1) + 'w';
						}
						return String(num);
					};

					const formatPlatformName = (p) => {
						const map = { douyin: '抖音', kuaishou: '快手', xiaohongshu: '小红书', bilibili: 'B站' };
						return map[p] || '其他';
					};

					const formatTime = (dateStr) => {
						if (!dateStr) return '';
						const d = new Date(dateStr);
						const pad = n => n < 10 ? '0' + n : n;
						return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
					};

					onMounted(() => {
						isLoaded.value = true;
						// 监听 hash 路由
						const hash = window.location.hash.replace('#', '');
						if (['index', 'detail', 'records'].includes(hash)) {
							currentPage.value = hash;
							if (hash === 'records') fetchRecords();
						}
					});

					return {
						isLoaded,
						currentPage,
						shareText,
						isLoading,
						dialogVisible,
						parseResult,
						textareaRef,
						imageList,
						allSelected,
						records,
						isRecordsLoading,
						statModal,
						lightbox,
						toast,
						svgLogos,
						videoProxySrc,
						selectedCount,
						goToPage,
						pasteInput,
						clearInput,
						useExample,
						parseVideo,
						toggleSelectAll,
						toggleImageSelect,
						previewImage,
						copyText,
						copyAuthorInfo,
						showStatModal,
						downloadVideo,
						downloadImages,
						shareApp,
						reParse,
						formatCount,
						formatPlatformName,
						formatTime
					};
				}
			});

			app.mount('#app');
		}

		if (typeof Vue !== 'undefined') {
			initApp();
		} else {
			document.addEventListener('DOMContentLoaded', () => {
				const check = setInterval(() => {
					if (typeof Vue !== 'undefined') {
						clearInterval(check);
						initApp();
					}
				}, 50);
			});
		}
	</script>
</body>

</html>