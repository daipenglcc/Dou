							</div>
						</div>

						<div class="bento-card bento-full bento-full-row">
							<div class="bento-icon-wrap bento-icon-primary">
								<svg class="icon-svg" width="24" height="24" viewBox="0 0 24 24">
									<path
										d="M4 6h18V4H4c-1.1 0-2 .9-2 2v11H0v3h14v-3H4V6zm19 2h-6c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h6c.55 0 1-.45 1-1V9c0-.55-.45-1-1-1zm-1 9h-4v-7h4v7z" />
								</svg>
							</div>
							<div class="bento-card-body">
								<div class="bento-card-title">多平台支持</div>
								<div class="bento-card-desc">支持解析抖音、快手、小红书、B站分享链接</div>
							</div>
						</div>

						<div class="bento-card bento-full bento-full-row">
							<div class="bento-icon-wrap bento-icon-primary">
								<svg class="icon-svg" width="24" height="24" viewBox="0 0 24 24">
									<path
										d="M9.64 7.64c.23-.5.36-1.05.36-1.64 0-2.21-1.79-4-4-4S2 3.79 2 6s1.79 4 4 4c.59 0 1.14-.13 1.64-.36L10 12l-2.36 2.36C7.14 14.13 6.59 14 6 14c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4c0-.59-.13-1.14-.36-1.64L12 14l7 7h3v-1L9.64 7.64zM6 8c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm0 12c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm6-7.5c-.28 0-.5-.22-.5-.5s.22-.5.5-.5.5.22.5.5-.22.5-.5.5zM19 3l-6 6 2 2 7-7V3h-3z" />
								</svg>
							</div>
