									</svg>
									<span class="stat-name">分享</span>
								</div>
							</div>
							<div class="stat-divider"></div>
							<div class="stat-item" @click="showStatModal('收藏', parseResult.statistics ? parseResult.statistics.collect_count : 0)">
								<div class="stat-label">{{ formatCount(parseResult.statistics ? parseResult.statistics.collect_count : 0) }}</div>
								<div class="stat-meta">
									<svg class="icon-svg" width="13" height="13" color="#9b6ddb" viewBox="0 0 24 24">
										<path
											d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
									</svg>
									<span class="stat-name">收藏</span>
								</div>
							</div>
						</div>
					</div>

					<!-- 视频模式 -->
					<div v-if="parseResult.project && parseResult.project.type === 'video'">
						<div class="section-header">
							<span class="section-title">视频预览</span>
							<div v-if="parseResult.platform" class="platform-source">
								<span class="platform-source-text">来自</span>
								<span class="platform-source-logo" v-html="svgLogos[parseResult.platform]"></span>
							</div>
						</div>
						<div class="video-card">
							<video class="video-player" :src="videoProxySrc" controls playsinline></video>
						</div>
					</div>

					<!-- 图集模式 -->
					<div v-else>
						<div class="stats-bar">
							<div class="stats-left">
								<span class="stats-number">{{ imageList.length }}</span>
								<span class="stats-label">张图片已解析</span>
								<div v-if="parseResult.platform" class="platform-source">
									<span class="platform-source-text">来自</span>
									<span class="platform-source-logo" v-html="svgLogos[parseResult.platform]"></span>
								</div>
							</div>
							<div class="btn-select-all" @click="toggleSelectAll">
								<svg class="icon-svg" width="18" height="18" viewBox="0 0 24 24">
									<path
										d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
								</svg>
								<span>{{ allSelected ? '取消全选' : '全选' }}</span>
							</div>
						</div>

						<div class="image-grid">
							<div v-for="item in imageList" :key="item.id" class="image-card">
								<img class="image-content" :src="item.url" @click="previewImage(item.url)"
									alt="preview" />
								<div class="select-badge" :class="{ selected: item.selected }"
									@click.stop="toggleImageSelect(item.id)">
